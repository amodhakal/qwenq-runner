{
  "name": "qwenq-runner",
  "version": "1.0.0",
  "private": true,
  "description": "Electron runner that opens a game iframe in a dedicated, maximized window.",
  "author": {
    "name": "amodhakal",
    "email": "amodhakal@users.noreply.github.com"
  },
  "main": "main.js",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:windows": "electron-builder --win",
    "build:win": "electron-builder --win",
    "build:dir": "electron-builder --dir"
  },
  "build": {
    "appId": "com.amodhakal.qwenqrunner",
    "productName": "qwenq-runner",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.games",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Game",
      "maintainer": "amodhakal <amodhakal@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "node-html-parser": "^6.1.13"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
